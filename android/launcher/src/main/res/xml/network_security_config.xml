<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Everything is https. The Saudi Quran Radio (radiojar) redirects to its CDN over http,
         so cleartext is allowed for that domain only. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">radiojar.com</domain>
    </domain-config>
    <!-- Older TVs may lack the HARICA root used by the Halls Booking server. -->
    <domain-config>
        <domain>hallsbooking.mtc.edu.om</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/harica_tls_rsa_root_ca_2021" />
        </trust-anchors>
    </domain-config>
</network-security-config>
